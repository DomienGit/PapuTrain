# Wzór pliku .env — skopiuj do .env i uzupełnij. .env NIGDY nie trafia do git.
# Sekret do podpisywania tokenów JWT. Wygeneruj własny losowy:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Po ilu dniach token wygasa (trzeba się ponownie zalogować)
TOKEN_EXPIRE_DAYS=30
# Klucz API Google Gemini (https://aistudio.google.com/apikey) — bez niego
# generowanie planów nie działa.
GEMINI_API_KEY=
# Kolejność modeli (przecinkami). Darmowy limit jest dzienny PER MODEL —
# gdy jeden się wyczerpie, backend sam przechodzi na następny z listy.
GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
